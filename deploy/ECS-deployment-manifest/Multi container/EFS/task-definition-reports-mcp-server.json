{
    "family": "<boldreports-mcp-server-task-definition-name>",
    "containerDefinitions": [
        {
            "name": "<boldreports-mcp-server-container-name>",
            "image": "syncfusion/boldreports-mcp-server:<update the latest image>",
            "cpu": 512,
            "memory": 1024,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "name": "reports-mcp-server",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                { "name": "BOLD_SERVICES_PV_USED", "value": "true" },
                { "name": "BOLD_SERVICES_HOSTING_ENVIRONMENT", "value": "docker" },
                { "name": "ID_API_SERVICE_URL", "value": "http://id-api-service:6001/api" },
                { "name": "BOLD_ETL_SERVICE_URL", "value": "http://bold-etl-service:6009" },
                { "name": "ID_WEB_SERVICE_URL", "value": "http://id-web-service:6000" },
                { "name": "BOLD_ETL_BLAZOR_SERVICE_URL", "value": "http://bold-etl-service:6009/framework/blazor.server.js" },
                { "name": "ID_UMS_SERVICE_URL", "value": "http://id-ums-service:6002/ums" },
                { "name": "REPORTS_WEB_SERVICE_URL", "value": "http://reports-web-service:6550/reporting" },
                { "name": "REPORTS_API_SERVICE_URL", "value": "http://reports-api-service:6551/reporting/api" },
                { "name": "REPORTS_JOBS_SERVICE_URL", "value": "http://reports-jobs-service:6552/reporting/jobs" },
                { "name": "REPORTS_DESIGNER_SERVICE_URL", "value": "http://reports-reportservice-service:6553/reporting/reportservice" },
                { "name": "REPORTS_VIEWER_SERVICE_URL", "value": "http://reports-viewer-service:6554/reporting/viewer" },
                { "name": "REPORTS_AI_SERVICE_URL", "value": "http://reports-ai-service:6555/reportsai" },
                { "name": "REPORTS_MCP_SERVICE_URL", "value": "http://reports-mcp-service:6556/reportsmcp" }
            ],
            "mountPoints": [
                {
                   "sourceVolume": "<efs-volume-name>", // Replace with your EFS volume name
                   "containerPath": "/application/app_data",
                   "readOnly": false
               }
            ],
            "volumesFrom": [],
            "secrets": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "boldreports",
                    "awslogs-region": "<aws-region>",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl -f http://localhost:80/health-check || exit 1"
                ],
                "interval": 30,
                "timeout": 10,
                "retries": 3,
                "startPeriod": 60
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "<ecs-task-role-arn>", // Replace with your ECS Task Role ARN
    "executionRoleArn": "<ecs-task-execution-role-arn>", // Replace with your ECS Execution Role ARN
    "networkMode": "awsvpc",
    "volumes": [
        {
           "name": "<efs-volume-name>", // Replace with your EFS volume name
           "efsVolumeConfiguration": {
               "fileSystemId": "<efs-file-system-id>", // Replace with your EFS File System ID
               "rootDirectory": "/",
               "transitEncryption": "ENABLED"
           }
       }
    ],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}
